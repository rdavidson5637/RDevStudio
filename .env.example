# Pub Quiz — AI question generation
ANTHROPIC_API_KEY=

# Pub Quiz — real-time multiplayer (Pusher)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Pub Quiz — game state persistence (add Vercel KV / Upstash Redis in production)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Wardrobe AI — vision tagging + styling verdict (reuses ANTHROPIC_API_KEY above)
ANTHROPIC_MODEL=claude-sonnet-5
# Wardrobe AI — Supabase (Postgres + Storage). Server-side only, never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=garments
# Wardrobe AI — admin token to upload/manage pieces (a long random string only you know)
WARDROBE_ADMIN_TOKEN=
# Wardrobe AI — ghost clothing (background removal). Optional; blank = keep original.
REMOVE_BG_API_KEY=
# Wardrobe AI — set to "true" to go live. Unset/anything else shows the coming-soon page.
WARDROBE_LIVE=
